# Copy to .env and fill in your own free-tier keys. Never commit .env itself.

# Which provider the pipeline uses by default: "groq" or "gemini"
LLM_PROVIDER=groq

# Free key: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
